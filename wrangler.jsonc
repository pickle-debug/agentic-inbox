{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// Access authenticates administrators; mailbox sessions authenticate internal users.
		// Single-site setup: protect /auth/admin/session with Access; set ADMIN_ORIGIN to the site origin.
		// 首次配置的回退域名；系统内保存收信策略后，以 R2 的 settings/reception.json 为准。
		// 保留此变量即可，新增域名不必继续修改这里；全接收请在系统设置中显式开启。
		"DOMAINS": "ordoeden.com,vibeapi.cc,heself.com,faapi.cc",
		// 独立的具体收件地址白名单：[] 不限制地址；非空时，全接收模式也仍受此名单限制。
		"EMAIL_ADDRESSES": []
	},
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "AUTH", "class_name": "AuthStore" },
			{ "name": "CONTACTS", "class_name": "ContactsStore" },
			// 收件箱未读汇总：每个邮箱写入后推送，刷新角标只读这一个对象。
			{ "name": "INBOX_INDEX", "class_name": "InboxIndex" },
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{ "tag": "v4", "new_sqlite_classes": ["AuthStore"] },
		{ "tag": "v5", "new_sqlite_classes": ["ContactsStore"] },
		{ "tag": "v6", "new_sqlite_classes": ["InboxIndex"] }
	]
}
